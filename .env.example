# 项目业务凭据唯一来源。复制为 .env 后 chmod 600 .env；不要提交真实值。
# 各连接器只读取自己需要的字段；不会导出到进程环境或传给研究员。
# 使用标准 KEY=VALUE；允许单/双引号字面量，不做变量或 shell 求值。
# 公共行情无需凭据，主网客户端不读取本文件。
# 由人类在本地 .env 填写获准的网页回测完整 Authorization 值。
# 不要填写主网 Deribit 或 OpenAI 密钥；不要把凭据发到聊天或提交 Git。
# CSV Data API Key 不是已确认的网页回测认证，本阶段不自动混用。
GREEKS_LIVE_AUTH_TOKEN=
# 可选：CSV 数据接口凭据；不用于提交网页回测，不会自动调用数据接口。
GREEKS_LIVE_DATA_API_KEY=

# Deribit 测试网专用；仅 testnet 连接器读取，不存在主网切换变量。
DERIBIT_TESTNET_CLIENT_ID=
DERIBIT_TESTNET_CLIENT_SECRET=
